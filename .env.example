# ==============================================================================
# SOCIAL MATTERS CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure credentials before launching.
# IMPORTANT: Never commit actual secret keys or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000

# MySQL 8 / MariaDB Connection String
DATABASE_URL="mysql://root:@localhost:3306/social_matters_crm?connection_limit=20&pool_timeout=10"

# Redis Cache & BullMQ Queue Host
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & CREDENTIAL ENCRYPTION AT REST
# ------------------------------------------------------------------------------
# JWT Access and Refresh Token Secrets
JWT_SECRET=social_matters_crm_jwt_production_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=social_matters_crm_refresh_production_secret_key_2026_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Master Key for Encrypting OAuth Tokens & API Secrets in MySQL
# MUST be 32 bytes (256 bits) in production
ENCRYPTION_KEY=social_matters_crm_default_32byte_master_encryption_key_2026

# ------------------------------------------------------------------------------
# 3. META (FACEBOOK & INSTAGRAM LEAD ADS) INTEGRATION
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Go to https://developers.facebook.com/ -> Create App (Type: Business).
# 2. Add 'Marketing API' and 'Webhooks'.
# 3. Configure Lead Ads Retrieval: requires 'leads_retrieval', 'pages_read_engagement', 'pages_show_list'.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v21.0
META_VERIFY_TOKEN=social_matters_meta_verify_token_2026
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/meta/oauth/callback

# ------------------------------------------------------------------------------
# 4. GOOGLE ADS LEAD FORM INTEGRATION
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Go to Google Cloud Console -> Create OAuth 2.0 Client ID (Web Application).
# 2. Add authorized redirect URI: http://localhost:4000/api/v1/integrations/google/oauth/callback
# 3. Apply for Google Ads API Developer Token in Google Ads Manager (MCC).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/oauth/callback
GOOGLE_WEBHOOK_KEY=google_lead_secret_2026

# ------------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS PLATFORM / CLOUD API
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Go to Meta Developer Portal -> WhatsApp -> Getting Started.
# 2. Obtain Phone Number ID, WhatsApp Business Account ID, and System User Access Token.
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_system_user_token
WHATSAPP_VERIFY_TOKEN=social_matters_meta_verify_token_2026

# ------------------------------------------------------------------------------
# 6. LINKEDIN LEAD GEN FORMS INTEGRATION
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Go to LinkedIn Developer Portal -> Create App -> Request 'Lead Gen' product.
# 2. OAuth scopes: r_ads, r_ads_leadgen_automation.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/integrations/linkedin/oauth/callback

# ------------------------------------------------------------------------------
# 7. PUBLIC TUNNEL FOR LOCAL TESTING (ngrok / Cloudflare Tunnel)
# ------------------------------------------------------------------------------
# Set this to your public HTTPS forwarding URL when testing webhooks locally:
# e.g., https://your-subdomain.ngrok-free.app
PUBLIC_WEBHOOK_BASE_URL=http://localhost:4000
